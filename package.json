{
  "name": "biolint-vscode",
  "displayName": "BioLint — DNA Linter for Synthetic Biology",
  "description": "Real-time linter for DNA: GC%, Tm (SantaLucia), ΔG hairpins, broken ORFs, restriction sites, BioGuard biosafety screening. Local-first, Enterprise-ready.",
  "version": "1.2.0",
  "publisher": "bioguard",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/l00e00b00i00g00/biolint-vscode.git"
  },
  "homepage": "https://github.com/l00e00b00i00g00/biolint-vscode",
  "bugs": {
    "url": "https://github.com/l00e00b00i00g00/biolint-vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b3d2e",
    "theme": "dark"
  },
  "keywords": [
    "dna",
    "synthetic-biology",
    "bioinformatics",
    "fasta",
    "genbank",
    "linter",
    "biosecurity",
    "primer"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:biofasta",
    "onLanguage:biogenbank",
    "onLanguage:biofastq",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "biofasta",
        "aliases": ["FASTA", "biofasta"],
        "extensions": [".fa", ".fasta", ".fna", ".ffn", ".faa", ".frn"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "biogenbank",
        "aliases": ["GenBank", "biogenbank"],
        "extensions": [".gb", ".gbk", ".genbank", ".gbf"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "biofastq",
        "aliases": ["FASTQ", "biofastq"],
        "extensions": [".fastq", ".fq"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "biofasta",
        "scopeName": "source.biofasta",
        "path": "./syntaxes/biofasta.tmLanguage.json"
      },
      {
        "language": "biogenbank",
        "scopeName": "source.biogenbank",
        "path": "./syntaxes/biogenbank.tmLanguage.json"
      },
      {
        "language": "biofastq",
        "scopeName": "source.biofastq",
        "path": "./syntaxes/biofastq.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "biofasta",
        "path": "./snippets/biolint.code-snippets.json"
      },
      {
        "language": "biogenbank",
        "path": "./snippets/biolint.code-snippets.json"
      },
      {
        "language": "json",
        "path": "./snippets/biolint.code-snippets.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "biolint.getStarted",
        "title": "%walkthrough.biolint.title%",
        "description": "%walkthrough.biolint.description%",
        "steps": [
          {
            "id": "biolint.walkthrough.lint",
            "title": "%walkthrough.biolint.lint.title%",
            "description": "%walkthrough.biolint.lint.description%",
            "media": { "path": "media/walkthrough-lint.md" }
          },
          {
            "id": "biolint.walkthrough.hover",
            "title": "%walkthrough.biolint.hover.title%",
            "description": "%walkthrough.biolint.hover.description%",
            "media": { "path": "media/walkthrough-hover.md" }
          },
          {
            "id": "biolint.walkthrough.certify",
            "title": "%walkthrough.biolint.certify.title%",
            "description": "%walkthrough.biolint.certify.description%",
            "media": { "path": "media/walkthrough-certify.md" }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "biolint.showSequenceView",
        "title": "%command.biolint.showSequenceView%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "biolint.exportCertificate",
        "title": "%command.biolint.exportCertificate%"
      },
      {
        "command": "biolint.verifyHash",
        "title": "%command.biolint.verifyHash%"
      },
      {
        "command": "biolint.installPreCommitHook",
        "title": "%command.biolint.installPreCommitHook%"
      },
      {
        "command": "biolint.switchMode",
        "title": "%command.biolint.switchMode%"
      },
      {
        "command": "biolint.loginEnterprise",
        "title": "%command.biolint.loginEnterprise%"
      },
      {
        "command": "biolint.logoutEnterprise",
        "title": "%command.biolint.logoutEnterprise%"
      },
      {
        "command": "biolint.optimizePrimer",
        "title": "%command.biolint.optimizePrimer%"
      },
      {
        "command": "biolint.reverseComplement",
        "title": "%command.biolint.reverseComplement%"
      },
      {
        "command": "biolint.checkPrimerPair",
        "title": "%command.biolint.checkPrimerPair%"
      },
      {
        "command": "biolint.optimizeCodons",
        "title": "%command.biolint.optimizeCodons%"
      },
      {
        "command": "biolint.openAuditLog",
        "title": "%command.biolint.openAuditLog%"
      },
      {
        "command": "biolint.exportAuditLog",
        "title": "%command.biolint.exportAuditLog%"
      },
      {
        "command": "biolint.showOutput",
        "title": "%command.biolint.showOutput%"
      },
      {
        "command": "biolint.diffConstructs",
        "title": "%command.biolint.diffConstructs%"
      },
      {
        "command": "biolint.openCommandCenter",
        "title": "%command.biolint.openCommandCenter%"
      },
      {
        "command": "biolint.openSynthFlowStudio",
        "title": "%command.biolint.openSynthFlowStudio%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "biolint.showSequenceView",
          "group": "navigation@9",
          "when": "resourceLangId == biofasta || resourceLangId == biogenbank || resourceLangId == biofastq"
        }
      ],
      "explorer/context": [
        {
          "command": "biolint.exportCertificate",
          "group": "biolint@1",
          "when": "resourceExtname =~ /\\.(fa|fasta|fna|ffn|faa|frn|gb|gbk|genbank|gbf|fastq|fq|yaml|yml|py|ts)$/i"
        },
        {
          "command": "biolint.verifyHash",
          "group": "biolint@2",
          "when": "resourceExtname =~ /\\.(fa|fasta|fna|ffn|faa|frn|gb|gbk|genbank|gbf|fastq|fq|yaml|yml|py|ts)$/i"
        }
      ],
      "editor/context": [
        {
          "command": "biolint.showSequenceView",
          "group": "biolint@1"
        },
        {
          "command": "biolint.optimizePrimer",
          "group": "biolint@2"
        },
        {
          "command": "biolint.reverseComplement",
          "group": "biolint@2"
        },
        {
          "command": "biolint.checkPrimerPair",
          "group": "biolint@2"
        },
        {
          "command": "biolint.optimizeCodons",
          "group": "biolint@2"
        }
      ],
      "commandPalette": [
        {
          "command": "biolint.showSequenceView"
        },
        {
          "command": "biolint.exportCertificate"
        },
        {
          "command": "biolint.verifyHash"
        },
        {
          "command": "biolint.installPreCommitHook"
        },
        {
          "command": "biolint.switchMode"
        },
        {
          "command": "biolint.loginEnterprise"
        },
        {
          "command": "biolint.logoutEnterprise"
        },
        {
          "command": "biolint.optimizePrimer"
        },
        {
          "command": "biolint.reverseComplement"
        },
        {
          "command": "biolint.checkPrimerPair"
        },
        {
          "command": "biolint.optimizeCodons"
        },
        {
          "command": "biolint.openAuditLog"
        },
        {
          "command": "biolint.exportAuditLog"
        },
        {
          "command": "biolint.showOutput"
        },
        {
          "command": "biolint.diffConstructs"
        },
        {
          "command": "biolint.openCommandCenter"
        },
        {
          "command": "biolint.openSynthFlowStudio"
        }
      ]
    },
    "configuration": {
      "title": "BioLint",
      "properties": {
        "biolint.mode": {
          "type": "string",
          "enum": ["local", "enterprise"],
          "default": "local",
          "description": "%config.biolint.mode%"
        },
        "biolint.enterpriseUrl": {
          "type": "string",
          "default": "https://app.bioguard.ai",
          "description": "%config.biolint.enterpriseUrl%"
        },
        "biolint.synthFlowStudioUrl": {
          "type": "string",
          "default": "https://studio.synthflow.ai",
          "description": "%config.biolint.synthFlowStudioUrl%"
        },
        "biolint.gc.warnLow": {
          "type": "number",
          "default": 35,
          "description": "%config.biolint.gc.warnLow%"
        },
        "biolint.gc.warnHigh": {
          "type": "number",
          "default": 65,
          "description": "%config.biolint.gc.warnHigh%"
        },
        "biolint.minPrimerLength": {
          "type": "number",
          "default": 15,
          "description": "%config.biolint.minPrimerLength%"
        },
        "biolint.minOrfLength": {
          "type": "number",
          "default": 90,
          "description": "%config.biolint.minOrfLength%"
        },
        "biolint.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "%config.biolint.enableHover%"
        },
        "biolint.enableLocalThreatDb": {
          "type": "boolean",
          "default": true,
          "description": "%config.biolint.enableLocalThreatDb%"
        },
        "biolint.debounceMs": {
          "type": "number",
          "default": 350,
          "description": "%config.biolint.debounceMs%"
        },
        "biolint.tm.primerConcNM": {
          "type": "number",
          "default": 250,
          "description": "%config.biolint.tm.primerConcNM%"
        },
        "biolint.tm.naConcMM": {
          "type": "number",
          "default": 50,
          "description": "%config.biolint.tm.naConcMM%"
        },
        "biolint.tm.mgConcMM": {
          "type": "number",
          "default": 0,
          "description": "%config.biolint.tm.mgConcMM%"
        },
        "biolint.codonHost": {
          "type": "string",
          "enum": ["ecoli", "yeast", "human"],
          "default": "ecoli",
          "description": "%config.biolint.codonHost%"
        },
        "biolint.codon.caiWarnBelow": {
          "type": "number",
          "default": 0.65,
          "description": "%config.biolint.codon.caiWarnBelow%"
        },
        "biolint.codon.customTablePath": {
          "type": "string",
          "default": "",
          "description": "%config.biolint.codon.customTablePath%"
        },
        "biolint.pair.maxDeltaTm": {
          "type": "number",
          "default": 5,
          "description": "%config.biolint.pair.maxDeltaTm%"
        },
        "biolint.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "%config.biolint.enableInlayHints%"
        },
        "biolint.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.biolint.debug%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "test": "npm run test:unit",
    "test:unit": "tsc -p ./ && node ./out/bio/__tests__/run.js",
    "package": "vsce package --no-dependencies",
    "package:vsix": "npm run compile && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
